        <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="14"/><Setter Property="MinHeight" Value="14"/></Trigger></Style.Triggers>
    </Style>
