<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <Deterministic>true</Deterministic>
    <RootNamespace>TopSolid.Automation.Mcp.Server.AddIn</RootNamespace>
    <TopSolidAutomationDirectory Condition="'$(TopSolidAutomationDirectory)' == ''">$(ProgramW6432)\TOPSOLID\TopSolid 7.20\bin</TopSolidAutomationDirectory>
    <!-- The legacy DLLs under TopSolid.Automation must never outrank the matched SDK. -->
    <AssemblySearchPaths>{HintPathFromItem};{TargetFrameworkDirectory};{RawFileName}</AssemblySearchPaths>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\TopSolid.Automation.Mcp.Contracts\TopSolid.Automation.Mcp.Contracts.csproj" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <Reference Include="System.ServiceModel" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="TopSolid.Kernel.Automating">
      <HintPath>$(TopSolidAutomationDirectory)\TopSolid.Kernel.Automating.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="TopSolid.Kernel.SX">
      <HintPath>$(TopSolidAutomationDirectory)\TopSolid.Kernel.SX.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="TopSolid.Cad.Design.Automating"><HintPath>$(TopSolidAutomationDirectory)\TopSolid.Cad.Design.Automating.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="TopSolid.Cad.Drafting.Automating"><HintPath>$(TopSolidAutomationDirectory)\TopSolid.Cad.Drafting.Automating.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="TopSolid.Cad.Electrode.Automating"><HintPath>$(TopSolidAutomationDirectory)\TopSolid.Cad.Electrode.Automating.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="TopSolid.Cam.NC.Kernel.Automating"><HintPath>$(TopSolidAutomationDirectory)\TopSolid.Cam.NC.Kernel.Automating.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="TopSolid.Cae.Kernel.Automating"><HintPath>$(TopSolidAutomationDirectory)\TopSolid.Cae.Kernel.Automating.dll</HintPath><Private>true</Private></Reference>
    <EmbeddedResource Include="..\docs\api\reference-index.json" LogicalName="TopSolid.ApiReference.json" />
    <EmbeddedResource Include="..\docs\api\reference-articles.json.gz" LogicalName="TopSolid.ApiArticles.json.gz" />
    <Content Include="TopSolid.Automation\**\*.json;TopSolid.Automation\**\*.md;TopSolid.Automation\**\*.html" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CheckTopSolidSdk" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(TopSolidAutomationDirectory)\TopSolid.Kernel.Automating.dll')" Text="TopSolid 7.20 Automation assemblies are required. Set TopSolidAutomationDirectory to a matched 7.20 assembly folder." />
  </Target>
</Project>
